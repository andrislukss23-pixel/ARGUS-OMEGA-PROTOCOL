+def _scan_declarations(rel: str, text: str, errors: list[str]) -> None:
+    checks = (
+        (
+            re.compile(r"(?im)^\s*(?:[-*]\s*)?(?:\*\*)?canonical(?: release)? version(?:\*\*)?\s*[:=]\s*[^\n]{0,40}?([vV]\d+\.\d+)", re.M),
+            CANONICAL_VERSION,
+            "canonical version",
+        ),
+        (
+            re.compile(r"(?im)^\s*(?:[-*]\s*)?(?:\*\*)?canonical ledger(?: boundary)?(?:\*\*)?\s*[:=]\s*[^\n]{0,40}?(T\d+)", re.M),
+            CANONICAL_LEDGER,
+            "canonical ledger",
+        ),
+        (
+            re.compile(r"(?im)^\s*(?:[-*]\s*)?(?:\*\*)?(?:recovered working-line boundary|latest recovered working boundary)(?:\*\*)?\s*[:=]\s*[^\n]{0,40}?(T1430-X\d+)", re.M),
+            WORKING_BOUNDARY,
+            "working boundary",
+        ),
+        (
+            re.compile(r"(?im)^\s*(?:[-*]\s*)?(?:\*\*)?(?:latest recovered defence state|defence patch)(?:\*\*)?\s*[:=]\s*[^\n]{0,40}?(OMEGA-HARD R\d+)", re.M),
+            DEFENCE_PATCH,
+            "defence patch",
+        ),
+    )
+    for pattern, expected, label in checks:
+        for match in pattern.finditer(text):
+            value = match.group(1)
+            if value.lower() != expected.lower():
+                errors.append(f"{rel}: contradictory {label} declaration: {value} != {expected}")
+
+    external_promoted = re.compile(
+        r"(?im)^\s*(?:[-*]\s*)?(?:\*\*)?(?:external(?: scientific)? validation)(?:\*\*)?\s*[:=]\s*(ESTABLISHED|VALIDATED|PASS(?:ED)?)\b"
