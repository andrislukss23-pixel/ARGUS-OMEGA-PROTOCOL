+#!/usr/bin/env python3
+"""Adversarial regression tests for the ARGUS repository-state validator."""
+
+from __future__ import annotations
+
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import validate_state as v  # noqa: E402
+
+
+BASE_STATE = {
+    "project": "ARGUS OMEGA",
+    "generated_date": "2026-09-27",
+    "target_repository": "andrislukss23-pixel/ARGUS-OMEGA-PROTOCOL",
+    "canonical": {
+        "version": "v0.35",
+        "codename": "Omega-Hepta-Prime",
+        "ledger_through": "T1422",
+        "status": "PROVISIONAL",
+        "validation_domain": "INTERNAL-SYNTHETIC / METHOD-LEVEL ONLY",
+    },
+    "post_canonical": {
+        "t1423_preserved_separately": True,
+        "latest_recovered_working_boundary": "T1430-X62",
+        "defence_patch": "OMEGA-HARD R61",
+        "disposition": "PROVISIONAL LIMITED_SURVIVOR",
+        "t1431": "RESERVED FOR MATERIALLY INDEPENDENT EXTERNAL CLEAN-ROOM VALIDATION",
+        "provenance_gaps": [
+            "T1430-X17 execution status",
+            "T1430-X51-X54 per-test detail",
+            "unmapped R9 continuation identifiers",
+        ],
+        "next_named_proposed_test": "T1430-X63",
+    },
+    "external_validation": "NOT ESTABLISHED",
+    "physical_validation": "NOT ESTABLISHED",
+    "field_validation": "NOT ESTABLISHED",
+    "deployment_certification": "NONE",
+    "reality_gate": "CLOSED / WOUNDED",
+    "reality_veto": "ABSOLUTE",
+    "high_consequence_operational_authority": "NONE",
+}
+
+
+class ValidatorAdversarialTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        (self.root / "docs").mkdir()
+        (self.root / "tools").mkdir()
+        self.patch_bytes = b"historical patch fixture\n"
+        (self.root / "patch ").write_bytes(self.patch_bytes)
+        self.patch_sha = v.git_blob_sha1(self.patch_bytes)
+        self.write_state(BASE_STATE)
+        core = (
+            "# ARGUS\n"
+            "Canonical version: v0.35\n"
+            "Canonical ledger boundary: T1422\n"
+            "Recovered working-line boundary: T1430-X62\n"
+            "Latest recovered defence state: OMEGA-HARD R61\n"
+            "T1431: RESERVED\n"
+            "External validation: NOT ESTABLISHED\n"
+        )
+        for rel in v.CORE_DOCS:
+            (self.root / rel).write_text(core, encoding="utf-8")
+        (self.root / "docs" / "PROVENANCE_GAPS.md").write_text(
+            "# Gaps\nDO NOT INVENT DETAILS\n", encoding="utf-8"
+        )
+
+    def tearDown(self) -> None:
+        self.tmp.cleanup()
+
+    def write_state(self, state: dict) -> None:
+        (self.root / "argus_working_state.json").write_text(
+            json.dumps(state, indent=2) + "\n", encoding="utf-8"
+        )
+
+    def errors(self) -> list[str]:
+        return v.validate_repo(
+            self.root,
+            expected_patch_blob_sha=self.patch_sha,
+            check_ci_contract=False,
+        )
+
+    def mutate(self, path: tuple[str, ...], value) -> None:
+        state = json.loads(json.dumps(BASE_STATE))
+        target = state
+        for part in path[:-1]:
+            target = target[part]
+        target[path[-1]] = value
+        self.write_state(state)
+
+    def assert_rejected(self, needle: str) -> None:
+        errors = self.errors()
+        self.assertTrue(any(needle in e for e in errors), errors)
+
+    # 1
+    def test_01_baseline_passes(self):
+        self.assertEqual(self.errors(), [])
+
+    # 2
+    def test_02_duplicate_top_level_key_rejected(self):
+        text = json.dumps(BASE_STATE)
+        text = text[:-1] + ', "project": "FORGED"}'
+        (self.root / "argus_working_state.json").write_text(text, encoding="utf-8")
+        self.assert_rejected("duplicate JSON key: project")
+
+    # 3
+    def test_03_duplicate_nested_key_rejected(self):
+        text = json.dumps(BASE_STATE)
