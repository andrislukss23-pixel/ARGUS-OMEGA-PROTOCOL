+        self.mutate(("canonical", "version"), "v0.36")
+        self.assert_rejected("canonical version")
+
+    # 7
+    def test_07_canonical_ledger_drift_rejected(self):
+        self.mutate(("canonical", "ledger_through"), "T1431")
+        self.assert_rejected("canonical ledger")
+
+    # 8
+    def test_08_canonical_status_promotion_rejected(self):
+        self.mutate(("canonical", "status"), "FINAL")
+        self.assert_rejected("canonical status")
+
+    # 9
+    def test_09_working_boundary_drift_rejected(self):
+        self.mutate(("post_canonical", "latest_recovered_working_boundary"), "T1430-X63")
+        self.assert_rejected("working boundary")
+
+    # 10
+    def test_10_defence_patch_drift_rejected(self):
+        self.mutate(("post_canonical", "defence_patch"), "OMEGA-HARD R62")
+        self.assert_rejected("defence patch")
+
+    # 11
+    def test_11_disposition_drift_rejected(self):
+        self.mutate(("post_canonical", "disposition"), "PROVEN")
+        self.assert_rejected("disposition")
+
+    # 12
+    def test_12_t1431_unreserved_rejected(self):
+        self.mutate(("post_canonical", "t1431"), "EXECUTED")
+        self.assert_rejected("T1431 must remain reserved")
+
+    # 13
+    def test_13_external_validation_promotion_rejected(self):
+        self.mutate(("external_validation",), "ESTABLISHED")
+        self.assert_rejected("external validation")
+
+    # 14
+    def test_14_reality_veto_weakening_rejected(self):
+        self.mutate(("reality_veto",), "OPTIONAL")
+        self.assert_rejected("reality veto")
+
+    # 15
+    def test_15_state_symlink_substitution_rejected(self):
+        target = self.root / "state-target.json"
+        target.write_text(json.dumps(BASE_STATE), encoding="utf-8")
+        (self.root / "argus_working_state.json").unlink()
+        (self.root / "argus_working_state.json").symlink_to(target)
+        self.assert_rejected("symlink substitution")
+
+    # 16
+    def test_16_core_doc_symlink_substitution_rejected(self):
+        target = self.root / "readme-target.md"
+        target.write_text((self.root / "README.md").read_text(), encoding="utf-8")
+        (self.root / "README.md").unlink()
+        (self.root / "README.md").symlink_to(target)
+        self.assert_rejected("symlink substitution")
+
+    # 17
+    def test_17_unscanned_style_doc_canonical_contradiction_rejected(self):
+        (self.root / "docs" / "extra.md").write_text(
+            "Canonical version: v0.36\n", encoding="utf-8"
+        )
+        self.assert_rejected("contradictory canonical version")
+
+    # 18
+    def test_18_unscanned_style_doc_working_boundary_contradiction_rejected(self):
+        (self.root / "docs" / "extra.md").write_text(
+            "Recovered working-line boundary: T1430-X99\n", encoding="utf-8"
+        )
